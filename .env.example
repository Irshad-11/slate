# Supabase project settings (Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Email of the single owner user you created in Authentication > Users.
# The access key is that user's password. Never put the key in this file.
VITE_OWNER_EMAIL=owner@example.com
